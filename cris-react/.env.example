# Copy to .env.local and adjust.
#
# VITE_USE_MOCK=true   -> every read comes from src/data + localStorage,
#                         writes land in localStorage. No backend needed.
# VITE_USE_MOCK=false  -> real requests through services/http.js.
VITE_USE_MOCK=false

# Where the Express API lives. Local default; deployed builds either point
# this at the API host (https://your-api.example.com/api) or use /api to
# ride the same origin as the page.
VITE_API_URL=http://localhost:5000/api
