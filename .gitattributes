# Keep the repo LF-only. Docker and the deploy scripts run on Linux, and a
# stray CRLF in a shell script produces the classic
# "/usr/bin/env: 'bash\r': No such file or directory".
* text=auto eol=lf
*.sh   text eol=lf
Dockerfile text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
