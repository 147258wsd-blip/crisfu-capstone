# MongoDB Atlas — include the database name, otherwise Mongoose writes to "test"
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crisfu?retryWrites=true&w=majority

# Any long random string. Changing this logs every session out.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

# Comma-separated extra origins allowed by CORS. localhost and *.vercel.app
# are always allowed, so this is only for a custom domain.
# CLIENT_ORIGIN=https://crisfu.vercel.app

# Windows only: Node's resolver sometimes refuses Atlas SRV lookups.
# Unset on Linux (Render, Railway, Fly).
# DNS_SERVERS=202.96.64.68,114.114.114.114

# Used by `npm run seed` for the owner account
SEED_USERNAME=crisfu
SEED_EMAIL=cris@crisfu.dev
SEED_PASSWORD=crisfu2026
